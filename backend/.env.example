# AdCraft AI — environment variables
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
PEXELS_API_KEY=...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: just localhost
# Production: add your Oracle VM public IP, e.g.:
#   ALLOWED_ORIGINS=http://localhost:3000,http://141.148.x.x
ALLOWED_ORIGINS=http://localhost:3000